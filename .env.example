# =============================================================================
# LocateConnect Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
CREDENTIALS_MASTER_KEY=your-credentials-master-key
CRON_SECRET=your-cron-secret

# -----------------------------------------------------------------------------
# Email Configuration (at least one provider required for production emails)
# -----------------------------------------------------------------------------
EMAIL_FROM=noreply@locateconnect.ca

# SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# AWS SES (see AWS section below for credentials)
# AWS_SES_REGION=us-east-1

# SMTP (fallback)
# SMTP_HOST=smtp.example.com

# -----------------------------------------------------------------------------
# SMS (Twilio)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Push Notifications (Web Push / VAPID)
# -----------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# -----------------------------------------------------------------------------
# AWS Services (Rekognition, SES)
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# -----------------------------------------------------------------------------
# Azure Face API (facial recognition)
# -----------------------------------------------------------------------------
# AZURE_FACE_API_KEY=your-azure-face-api-key
# AZURE_FACE_API_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_FACE_KEY=your-azure-face-key
# AZURE_FACE_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# -----------------------------------------------------------------------------
# Transcription / Speech-to-Text
# -----------------------------------------------------------------------------
# Supported providers: openai, deepgram, assemblyai
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# DEEPGRAM_API_KEY=your-deepgram-api-key
# ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# -----------------------------------------------------------------------------
# Social Media Monitoring
# -----------------------------------------------------------------------------
# SOCIAL_MONITORING_WEBHOOK_SECRET=your-webhook-secret
# SOCIAL_MONITORING_VERIFY_TOKEN=your-verify-token
# FACEBOOK_APP_ID=your-facebook-app-id
# TWITTER_API_KEY=your-twitter-api-key
# TWITTER_API_SECRET=your-twitter-api-secret
# INSTAGRAM_CLIENT_ID=your-instagram-client-id

# -----------------------------------------------------------------------------
# News & Public Records
# -----------------------------------------------------------------------------
# NEWSAPI_KEY=your-newsapi-key
# AGENCY_ID=your-agency-id

# -----------------------------------------------------------------------------
# Missing Persons Databases (NamUs, NCMEC)
# -----------------------------------------------------------------------------
# NAMUS_API_URL=https://www.namus.gov/api
# NAMUS_API_KEY=your-namus-api-key
# NCMEC_API_URL=https://api.missingkids.org
# NCMEC_API_KEY=your-ncmec-api-key

# -----------------------------------------------------------------------------
# Photo / Age Progression
# -----------------------------------------------------------------------------
# AGE_PROGRESSION_API_URL=https://your-age-progression-service.com/api
# AGE_PROGRESSION_API_KEY=your-age-progression-api-key

# -----------------------------------------------------------------------------
# IP Geolocation
# -----------------------------------------------------------------------------
# IPINFO_API_KEY=your-ipinfo-api-key

# -----------------------------------------------------------------------------
# Weather
# -----------------------------------------------------------------------------
# WEATHERAPI_API_KEY=your-weatherapi-key

# -----------------------------------------------------------------------------
# Hospital Registries (JSON configuration string)
# -----------------------------------------------------------------------------
# HOSPITAL_REGISTRIES=[]

# -----------------------------------------------------------------------------
# Tip Verification Engine Thresholds (all optional; defaults shown)
# -----------------------------------------------------------------------------
# TIP_AUTO_VERIFY_THRESHOLD=75
# TIP_SPAM_THRESHOLD=70
# TIP_REVIEW_THRESHOLD=40
# TIP_MAX_PLAUSIBLE_DISTANCE=500
# TIP_MAX_TRAVEL_SPEED=200
# TIP_WEIGHT_PHOTO=0.20
# TIP_WEIGHT_LOCATION=0.20
# TIP_WEIGHT_TIME=0.15
# TIP_WEIGHT_TEXT=0.15
# TIP_WEIGHT_CROSS_REFERENCE=0.15
# TIP_WEIGHT_TIPSTER_RELIABILITY=0.15
# TIP_SLA_CRITICAL_HOURS=1
# TIP_SLA_HIGH_HOURS=4
# TIP_SLA_MEDIUM_HOURS=24
# TIP_SLA_LOW_HOURS=72

# -----------------------------------------------------------------------------
# Build Metadata (typically set automatically in CI)
# -----------------------------------------------------------------------------
# BUILD_TIME=2024-01-01T00:00:00Z
# GIT_COMMIT=abc1234
# NODE_VERSION=20
